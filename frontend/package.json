{
  "name": "flickpond-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tests for the Flickpond upload/poll frontend. No build step - app.js stays a plain script the browser loads directly.",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=app.js --coverage.include=clip-scrubber.js --coverage.include=crop-box.js --coverage.include=motion.js --coverage.include=preset.js --coverage.include=adjust.js --coverage.thresholds.statements=90 --coverage.thresholds.branches=90 --coverage.thresholds.functions=90 --coverage.thresholds.lines=90",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^25.0.1",
    "vitest": "^5.0.5"
  }
}
