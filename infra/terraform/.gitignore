# State holds resource IDs and the instance's addresses; variables files
# hold operator IPs. Neither belongs in the repo.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
crash.log
# Saved plans embed variable values.
*.plan
plan.txt
apply.txt

# Backend settings name the account's state bucket; the example is the template.
*.backend.hcl
!example.backend.hcl

# Local overrides, e.g. planning against local state before the bucket exists.
*_override.tf
