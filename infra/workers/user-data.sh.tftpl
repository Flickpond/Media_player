#!/bin/bash
# Autoscaling worker, first boot. Rendered by Terraform (compute.tf): the
# values in dollar-brace are filled in there; shell expansions are escaped.
#
# Holds no secrets and no addresses. Where the datastores are, and how to get
# in, is read from Parameter Store with the instance role -- the same three
# parameters deploy/aws/fetch-secrets.sh gives the core host, written there
# by the base (infra/terraform/datastores.tf). Anyone who can read this
# launch template learns neither.
set -euo pipefail

region='${region}'
parameter_path='${parameter_path}'

dnf install -y docker
systemctl enable --now docker

param() {
  aws ssm get-parameter --region "$region" --with-decryption \
    --name "$parameter_path/$1" --query Parameter.Value --output text
}
# The DSN arrives whole, ?ssl=require included: RDS refuses plain connections
# (rds.force_ssl), and asyncpg rejects sslmode. Its password is letters and
# digits only, so nothing in it needs escaping.
postgres_dsn="$(param postgres_dsn)"
redis_host="$(param redis_host)"
redis_password="$(param redis_password)"

# Root-only, and the reason --env-file is used rather than -e on the command
# line: process arguments are readable by every user on the host.
#
# REDIS_SSL=true because ElastiCache has in-transit encryption on and drops
# plain-text clients without a readable error.
install -d -m 700 /etc/flickpond
umask 077
cat > /etc/flickpond/worker.env <<EOF
REDIS_HOST=$redis_host
REDIS_PORT=${cache_port}
REDIS_SSL=true
REDIS_PASSWORD=$redis_password
REDIS_QUEUE=video_jobs
POSTGRES_DSN=$postgres_dsn
MINIO_ENDPOINT=s3.${region}.amazonaws.com
MINIO_USE_SSL=true
MINIO_BUCKET=${bucket_name}
MINIO_REGION=${region}
STORAGE_USE_INSTANCE_ROLE=true
%{ for key, value in worker_settings ~}
${key}=${value}
%{ endfor ~}
EOF
unset postgres_dsn redis_host redis_password

aws ecr get-login-password --region "$region" \
  | docker login --username AWS --password-stdin '${registry}'
docker pull '${image}'

# --stop-timeout: when the instance shuts down (spot reclaim, scale-in),
# Docker sends SIGTERM and RQ starts a warm shutdown, finishing the current
# job if it can. A spot warning gives two minutes, so Docker waits 110 s
# before SIGKILL. A job cut off there is recovered by the reaper's lease.
docker run -d --name worker \
  --restart unless-stopped \
  --stop-timeout 110 \
  --env-file /etc/flickpond/worker.env \
  --log-opt max-size=20m --log-opt max-file=3 \
  '${image}' \
  python -m app.worker
