#!/bin/bash
# Autoscaling worker, first boot. Rendered by Terraform (compute.tf): the
# values in dollar-brace are filled in there; shell expansions are escaped.
#
# Holds no secrets and no addresses. Where the datastores are, and how to get
# in, is read from Parameter Store with the instance role -- the same three
# parameters deploy/aws/fetch-secrets.sh gives the core host, written there
# by the base (infra/terraform/datastores.tf). Anyone who can read this
# launch template learns neither.
set -euo pipefail

region='${region}'
parameter_path='${parameter_path}'

# The ECS-optimized image (compute.tf) has Docker; plain AL2023 has not.
# Either boots; the first skips half a minute of package installs.
command -v docker >/dev/null || dnf install -y docker
command -v aws >/dev/null || dnf install -y awscli-2
# Its ECS agent is enabled by default and would retry a cluster forever.
systemctl disable --now ecs 2>/dev/null || true
systemctl enable --now docker

param() {
  aws ssm get-parameter --region "$region" --with-decryption \
    --name "$parameter_path/$1" --query Parameter.Value --output text
}
# The DSN arrives whole, ?ssl=require included: RDS refuses plain connections
# (rds.force_ssl), and asyncpg rejects sslmode. Its password is letters and
# digits only, so nothing in it needs escaping.
postgres_dsn="$(param postgres_dsn)"
redis_host="$(param redis_host)"
redis_password="$(param redis_password)"

# Root-only, and the reason --env-file is used rather than -e on the command
# line: process arguments are readable by every user on the host.
#
# REDIS_SSL=true because ElastiCache has in-transit encryption on and drops
# plain-text clients without a readable error.
install -d -m 700 /etc/flickpond
umask 077
cat > /etc/flickpond/worker.env <<EOF
REDIS_HOST=$redis_host
REDIS_PORT=${cache_port}
REDIS_SSL=true
REDIS_PASSWORD=$redis_password
REDIS_QUEUE=video_jobs
POSTGRES_DSN=$postgres_dsn
MINIO_ENDPOINT=s3.${region}.amazonaws.com
MINIO_USE_SSL=true
MINIO_BUCKET=${bucket_name}
MINIO_REGION=${region}
STORAGE_USE_INSTANCE_ROLE=true
%{ for key, value in worker_settings ~}
${key}=${value}
%{ endfor ~}
EOF
unset postgres_dsn redis_host redis_password

aws ecr get-login-password --region "$region" \
  | docker login --username AWS --password-stdin '${registry}'
docker pull '${image}'

# --stop-timeout: Docker's grace before SIGKILL whenever the container is
# stopped, including by an OS shutdown the drain below did not see coming.
# 100 s, contract 2.3: on SIGTERM the worker stops FFmpeg and gives its job
# back (app.worker.interruption), which takes seconds, inside AWS's two-minute
# spot warning either way.
docker run -d --name worker \
  --restart unless-stopped \
  --stop-timeout 100 \
  --env-file /etc/flickpond/worker.env \
  --log-opt max-size=20m --log-opt max-file=3 \
  '${image}' \
  python -m app.worker

# The drain (contract 2.3): a worker about to disappear gives its job back
# first. Two warnings reach the instance through its metadata, and both get
# the same answer, `docker stop --time 100 worker`:
#
#   spot/instance-action                 a spot reclaim, two minutes out
#   autoscaling/target-lifecycle-state   Terminated: a scale-in or a capacity
#                                        rebalance, held by the group's
#                                        lifecycle hook until the drain is done
#
# Polled every 5 s, so after a spot warning the worker has stopped at worst
# 105 s into the 120. Not secret: the group's name and the hook's.
cat > /etc/flickpond/drain.env <<EOF
REGION=${region}
GROUP_NAME=${group_name}
HOOK_NAME=${drain_hook_name}
EOF

cat > /usr/local/bin/flickpond-drain <<'DRAIN'
#!/bin/bash
set -uo pipefail

imds() {
  local token
  token="$(curl -sf -X PUT http://169.254.169.254/latest/api/token \
    -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')" || return 1
  curl -sf -H "X-aws-ec2-metadata-token: $token" \
    "http://169.254.169.254/latest/meta-data/$1"
}

while sleep 5; do
  if imds spot/instance-action >/dev/null; then
    reason='spot interruption notice'
  elif [ "$(imds autoscaling/target-lifecycle-state)" = Terminated ]; then
    reason='scale-in'
  else
    continue
  fi
  echo "$reason: stopping the worker so it gives its job back"
  docker stop --time 100 worker || true
  # Lets the group terminate now instead of at the hook's timeout. Fails
  # harmlessly after a spot notice, which is not held by the hook.
  aws autoscaling complete-lifecycle-action --region "$REGION" \
    --auto-scaling-group-name "$GROUP_NAME" --lifecycle-hook-name "$HOOK_NAME" \
    --instance-id "$(imds instance-id)" --lifecycle-action-result CONTINUE || true
  exit 0
done
DRAIN
chmod 755 /usr/local/bin/flickpond-drain

cat > /etc/systemd/system/flickpond-drain.service <<'UNIT'
[Unit]
Description=Stop the worker, so it gives its job back, before this instance goes
After=docker.service
Requires=docker.service

[Service]
EnvironmentFile=/etc/flickpond/drain.env
ExecStart=/usr/local/bin/flickpond-drain
# Exits 0 once it has drained: nothing left to watch for.
Restart=on-failure

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now flickpond-drain.service
