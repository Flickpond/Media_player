# .env for the AWS core host. Copy to .env in the repo root, fill the values
# marked FILL, then run `deploy/aws/fetch-secrets.sh <environment>` to append
# the RDS and ElastiCache settings from SSM without printing them.

# --- storage: S3 instead of MinIO -------------------------------------------
MINIO_ENDPOINT=s3.ap-southeast-1.amazonaws.com
MINIO_USE_SSL=true
# Browsers fetch signed URLs from S3 directly, not through nginx's /videos/.
MINIO_PUBLIC_ENDPOINT=s3.ap-southeast-1.amazonaws.com
MINIO_PUBLIC_USE_SSL=true
MINIO_BUCKET=FILL                          # terraform output bucket_name
MINIO_REGION=ap-southeast-1
# No MINIO_ACCESS_KEY / MINIO_SECRET_KEY: the instance role supplies them.

# --- application secret: fresh for this deployment --------------------------
#   openssl rand -base64 48
JWT_SECRET=FILL

# Do not add POSTGRES_DSN, REDIS_HOST or REDIS_PASSWORD by hand. They are
# written from /flickpond/<environment>/ in SSM by fetch-secrets.sh. The
# Compose core overlay refuses to render while they are missing.

# --- AWS integration ---------------------------------------------------------
AWS_REGION=ap-southeast-1
COMPOSE_PROFILES=tls,metrics
METRICS_ENVIRONMENT=FILL                 # staging or production
METRICS_REGION=ap-southeast-1

# --- nginx: published on 80/443 like the current server ---------------------
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=80
FRONTEND_TLS_PORT=443
